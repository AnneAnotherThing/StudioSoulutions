# Studio Soulutions, Netlify redirects
# Pretty URLs for the entry points
/kiosk      /kiosk.html      200

# The old localStorage demo admin retired 2026-09-14; /leads/ wears its
# look now and carries all the live plumbing. One admin, one address.
/admin        /leads/   301
/admin.html   /leads/   301

# The old concept demo at /app retired 2026-09-14; the real app dressed
# as the demonstration building is the demo now.
/app        /a/demo   301
/app.html   /a/demo   301
/app/*      /a/demo   301

# One app, every building: /a/<slug> serves the real app dressed as that
# building (app.js reads the slug from the path). /a/demo is the sales
# demo Laura shows prospects.
/a/*        /salonplus/app/index.html   200

# One portal, every building, without Salon Plus in the address bar:
# /portal/?b=<slug> serves the same page, which dresses itself in that
# building's name. Salon Plus's own printed path stays canonical, so
# nothing in the wild breaks. Anne's ask, waggle 2026-09-15.
/portal      /salonplus/offer/index.html   200
/portal/*    /salonplus/offer/index.html   200

# The feature sheet was built and culled the same night (2026-09-15);
# anything pointing at it lands on the homepage. Anne's meeting sheet
# moved to the product root minutes after it was born under salonplus.
/features                /   301
/features/*              /   301
/salonplus/features      /   301
/salonplus/features/*    /   301
/salonplus/meeting       /meeting/   301
/salonplus/meeting/*     /meeting/   301

# Community and pricing are parked until we expand; pages stay in the
# repo, just unreachable. The ! forces the redirect even though the
# files exist, which plain rules never override. Drop this block to
# bring them back (and restore the /community pretty URL above).
/community      /   302!
/community.html /   302!
/pricing        /   302!
/pricing/*      /   302!

# Leads moved to one home for every building
/salonplus/leads.html   /leads/   301
/salonplus/leads        /leads/   301

# Laura's page moved out from under the building it started in
/salonplus/laura     /laura/   301
/salonplus/laura/*   /laura/   301

# The old launch-pad page retired 2026-09-15; the hub replaced it long ago
/Laura-Walkthrough.html   /laura/   301

# One document now: the owner's guide and the admin manual retired into
# the rollout 2026-09-15 (Anne's call, the manual's unique content folded
# into rollout page 10 first)
/salonplus/guide     /salonplus/rollout/   301
/salonplus/guide/*   /salonplus/rollout/   301
/leads/guide         /salonplus/rollout/   301
/leads/guide/*       /salonplus/rollout/   301
